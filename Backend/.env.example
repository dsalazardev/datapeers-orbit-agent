# ORBIT backend configuration.
# Copy this file to `.env` for local development. Never commit real secrets:
# `.env` is git-ignored and this template must stay free of credentials.

# Environment name (default: local). Used for identification in logs.
ORBIT_APP_ENV=local

# Log level for the structured JSON logger: DEBUG, INFO, WARNING, ERROR, CRITICAL (default: INFO).
ORBIT_LOG_LEVEL=INFO

# Scraper: request timeout in seconds (default: 10).
ORBIT_SCRAPER_TIMEOUT=10

# Scraper: max HTML body size to fetch/parse in bytes, 2MB default (spam-safe).
ORBIT_SCRAPER_MAX_BODY_SIZE=2097152

# Scraper: local JSON cache directory for pre-scrape results (default: .cache/scraping).
ORBIT_SCRAPER_CACHE_DIR=.cache/scraping

# Scraper: optional seed.json path used as offline fallback for demos (default: none).
ORBIT_SCRAPER_SEED_FILE=

# Scraper: enable the seeded fallback when fetch fails (default: true).
ORBIT_SCRAPER_SEED_ENABLED=true

# Scraper: cache entry lifetime in seconds (default: 3600).
ORBIT_SCRAPER_CACHE_TTL=3600

# LLM classifier: OpenRouter API key for batch project classification. Keep it
# only in `.env` (never commit); when unset the pre-scraper runs in fallback mode.
ORBIT_OPENROUTER_API_KEY=

# LLM classifier: model id used for the batch classification call (default: deepseek v4 flash 0731 free).
ORBIT_LLM_MODEL=deepseek/deepseek-v4-flash-0731:free

# LLM classifier: hard timeout per classification call in seconds (default: 8).
ORBIT_LLM_TIMEOUT=8

# LLM classifier: max output tokens allowed for the batch response (default: 4096).
ORBIT_LLM_MAX_TOKENS=4096
